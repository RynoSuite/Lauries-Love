# Dependencies
**/node_modules/
.pnp
.pnp.js

# Env & secrets (do NOT commit — will be handled later)
**/.env
**/.env.*
!**/.env.example
api/firebase.json
**/*.p8
**/*.pem
**/*.keystore

# NOTE: google-services.json and GoogleService-Info.plist are Firebase CLIENT
# config files. They ship inside the distributed app binary and are NOT secrets
# (per Firebase docs). They are intentionally committed because the EAS
# bare-workflow Gradle/Xcode build requires them present in the repo.

# Builds
**/dist/
**/build/
app/.expo/
app/ios/Pods/
app/ios/build/
app/android/build/
app/android/.gradle/
app/android/app/build/
**/coverage/

# Native
**/*.xcuserstate
**/DerivedData/

# Misc
.DS_Store
*.log
npm-debug.*
yarn-error.log

# Local design refs (brand guide, UI mockups) — not for the repo
_handoff-assets/

# TypeScript incremental build cache — a build artifact, not source
web/tsconfig.tsbuildinfo
