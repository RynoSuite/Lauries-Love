# index.html and version.json must never be cached: they are how a browser
# discovers there is a new build at all. The hashed files under /assets change
# name every build, so they are safe to keep forever.
/index.html
  Cache-Control: no-cache, must-revalidate
/version.json
  Cache-Control: no-cache, must-revalidate
/assets/*
  Cache-Control: public, max-age=31536000, immutable
