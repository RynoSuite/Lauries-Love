{
  "cli": {
    "appVersionSource": "local",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "node": "22.11.0",
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "node": "22.11.0",
      "channel": "production",
      "environment": "production",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "android": {
        "resourceClass": "large"
      }
    },
    "staging": {
      "node": "22.11.0",
      "environment": "development",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "testflight": {
      "node": "22.11.0",
      "environment": "development",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "distribution": "store",
      "ios": {
        "autoIncrement": "buildNumber",
        "image": "macos-sequoia-15.6-xcode-26.0"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "diagnose": {
      "node": "22.11.0",
      "environment": "development",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "distribution": "internal",
      "ios": {
        "image": "macos-sequoia-15.6-xcode-16.4"
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "appleTeamId": "49HFHLWS47",
        "ascAppId": "6814278840"
      }
    }
  }
}
